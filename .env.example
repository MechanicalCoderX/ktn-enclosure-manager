# Copy to .env and fill in. Keep the real .env at mode 0600 - it holds an API key.
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------- networking
# Bind to a specific LAN address rather than every interface if you prefer.
KTN_BIND_ADDRESS=0.0.0.0
KTN_PUBLISH_PORT=8420

# Where the app keeps accounts, the session key, IDENT timers and the audit log.
# On TrueNAS put this on a dataset so it survives app redeployment.
KTN_DATA_PATH=./data

# ------------------------------------------------------------------ hardware
# The SES device node to expose to the container. The application discovers the
# correct enclosure itself; this only has to exist so the node is visible.
# Find it with:  lsscsi -g | grep enclosu
KTN_SG_DEVICE=/dev/sg16

# How the Identify LED is driven:
#   auto  (default) prefer a SCSI command, fall back to sysfs if sg_ses is absent
#   ses             SCSI command only - works under the default container confinement
#   sysfs           write /sys/class/enclosure/.../locate - needs a writable /sys
#                   AND apparmor=unconfined on the container
KTN_IDENT_METHOD=auto

# Optional: restrict management to specific enclosures by logical id
# (comma-separated). Empty means every enclosure discovered.
# Find yours with:  cat /sys/class/enclosure/*/id
KTN_ENCLOSURE_ALLOWLIST=

# ------------------------------------------------------------------- TrueNAS
# Pool, vdev, ZFS error and SMART data come from the TrueNAS API. Leave the URL
# empty to run without it: the drive map and chassis telemetry still work.
#
# Create a key in the TrueNAS UI:  Credentials -> API Keys -> Add
KTN_TRUENAS_URL=https://truenas.example.lan
KTN_TRUENAS_API_KEY=

# TLS verification defaults to on. Only set this to false for a self-signed
# certificate you cannot replace, and prefer supplying a CA bundle instead.
KTN_TRUENAS_VERIFY_TLS=true
# KTN_TRUENAS_CA_BUNDLE=/data/truenas-ca.pem

# -------------------------------------------------------------- alerting
# Get told when a bay's health changes, instead of only seeing it if you happen
# to have the page open. Fires on transitions only, so a permanently degraded
# pool does not message every poll, and state persists across restarts.
#
# An ntfy topic URL, or any endpoint that accepts a POST. Empty disables it.
KTN_ALERT_WEBHOOK_URL=
# ntfy = plain-text body with Title/Priority/Tags headers; json = JSON object
KTN_ALERT_STYLE=ntfy
KTN_ALERT_ON_RECOVERY=true

# ---------------------------------------------------------- authentication
# Require a local account to view anything. Default true.
#
# Setting this false makes the app an open read-only dashboard, which is the
# norm for this category on TrueNAS: scrutiny, glances, homepage and
# speedtest-tracker all serve disk telemetry with no credentials, and scrutiny
# publishes the same class of data this app does (serial, WWN, SMART).
#
# It opens everything readable, including the audit log and raw sg_ses output.
# Only do it on a network you would already let read those.
KTN_AUTH_REQUIRED=true

# Allow the Identify LED write without an account. Default false, and it stays
# false even when KTN_AUTH_REQUIRED=false.
#
# Every comparable open dashboard is strictly read-only; this one can actuate
# hardware. The LED is non-destructive - there is no code path to power a drive
# off, reset a PHY or touch a fault LED - but a write reachable by anyone on
# the network should be a decision you made on purpose.
KTN_ALLOW_ANONYMOUS_IDENT=false

# ------------------------------------------------------------------- polling
# Conservative defaults. One backend poll serves every connected browser.
KTN_POLL_SLOTS_SECONDS=5
KTN_POLL_TRUENAS_SECONDS=20
KTN_POLL_SES_SECONDS=30
KTN_POLL_SMART_SECONDS=120

# Cross-process lock serialising access to the enclosure processor. It keeps
# an IDENT write and its settle read-back from being interleaved with other
# enclosure traffic, so a reader cannot observe a half-applied locate state.
#
# (It is NOT what stops the HBA logging SCSI aborts - that was sg_ses issuing
# an unsupported REPORT TIMESTAMP, fixed in 1.2.2 with --no-time.)
#
# In the container the entrypoint points this at /run/ktn/enclosure.lock, on
# the same private tmpfs as the helper socket. Outside it, it defaults to
# <data dir>/enclosure.lock. Both the web process and the privileged helper
# must resolve the same path or they exclude nothing, and the file has to be
# openable by both - the container has no CAP_DAC_OVERRIDE, so root is subject
# to the mode just like uid 1000.
# KTN_ENCLOSURE_LOCK=/run/ktn/enclosure.lock
